            "frc_lambda" : 1,
            "enr_lambda" : 1,
	    "str_lambda" : 1
    },
    "predict" : {
            "fname_traj" : "../dataset/test_300K.xyz",
            "model" : "model.pkl",
            "uncertainty_output": "mve_predictions.json"
    }
