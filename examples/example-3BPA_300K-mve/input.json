{
    "device" : "cpu",
    "gpu-parallel" : false,
    "model" : "race",
    "interaction_block" : "slow",
    "oeq_config" : false,
    "cueq_config" : false,
    "regress_forces" : "auto",
    "trainer" : "mve",
    "mve" : {
        "enabled": true,
        "version": 1,
        "floors": {"energy": 0.0001, "forces": 0.0001, "stress": 0.000001},
        "units": {"energy": "eV^2", "forces": "(eV/Å)^2", "stress": "(eV/Å^3)^2"}
    },
    "fname_traj" : "../dataset/train_300K.xyz",
    "ntrain" : 450,
    "nvalid" : 50,
    "cutoff" : 3.0,
    "avg_num_neighbors": 19,
    "num_species" : 4,
    "max_ell" : 2,
    "num_radial_basis" : 8,
    "hidden_channels" : "32x0o + 32x0e + 16x1o + 16x1e + 8x2o + 8x2e",
    "output_channels" : "2x0e+3x1o+6x2e",
